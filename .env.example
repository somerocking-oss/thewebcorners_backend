NODE_ENV=development
PORT=5004
APP_NAME=Webcorners
# Public URL of this API — used to build absolute /uploads URLs for images.
# MUST be set to the real production domain, otherwise uploaded image URLs
# will point at localhost and break on the live site.
APP_URL=http://localhost:5004

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/Webcorners?appName=Cluster0

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5174

ADMIN_SEED_EMAIL=admin@thewebcorners.com
ADMIN_SEED_PASSWORD=change-me-on-first-login
ADMIN_SEED_NAME=Webcorners Admin
